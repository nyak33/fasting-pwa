# Copy this file to .env and fill in real values.
VAPID_PUBLIC_KEY=YOUR_PUBLIC_VAPID_KEY
VAPID_PRIVATE_KEY=YOUR_PRIVATE_VAPID_KEY
VAPID_SUBJECT=mailto:admin@example.com

# Frontend URL used in push notification deep links.
FRONTEND_BASE_URL=https://syaqirshaq.online

# Comma-separated allow list or *
CORS_ORIGINS=https://syaqirshaq.online,https://www.syaqirshaq.online,https://fasting.syaqirshaq.online,http://localhost:5500,http://127.0.0.1:5500

# JAKIM prayer times zone and label shown in frontend card.
PRAYER_ZONE=SGR01
PRAYER_LOCATION=Taman Pinggiran Putra, Seri Kembangan, Selangor
PRAYER_CITY=Seri Kembangan
PRAYER_COUNTRY=Malaysia
PRAYER_METHOD=11

# SQLite file path
FASTING_DB_PATH=./fasting.db
